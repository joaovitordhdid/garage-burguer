# Garage Burger: variáveis de ambiente.
# Na Vercel, cadastre em Project → Settings → Environment Variables (não suba um arquivo .env para o GitHub).
# No computador, sem DATABASE_URL o sistema usa um Postgres embutido (PGlite) na pasta ./data.

# Banco Supabase: Project Settings → Database → Connection string → "Transaction pooler" (porta 6543).
# Troque [YOUR-PASSWORD] pela senha do banco.
DATABASE_URL=postgresql://postgres.SEU_PROJETO:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Conta do dono, criada no primeiro acesso (depois a senha pode ser trocada no painel)
ADMIN_EMAIL=dono@garageburger.com
ADMIN_PASSWORD=troque-por-uma-senha-forte

# Fotos enviadas pelo painel (Supabase Storage, bucket público "uploads" criado sozinho).
# Project Settings → API: "Project URL" e a chave "service_role" (secreta, só no servidor).
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Nota fiscal (opcional: substituem o que está no painel)
FOCUS_NFE_TOKEN=
# mock | homologacao | producao
NFE_MODE=

# Opcionais
# NODE_ENV=production          # a Vercel já define; ativa cookie seguro e desliga os dados de exemplo
# ORDER_RATE_LIMIT=8           # pedidos por IP a cada 10 min (por instância)
# DATABASE_POOL_MAX=3          # conexões por instância
# DATA_DIR=./data              # só local: pasta do banco embutido
